# VIP GROUP COWORK — cấu hình mẫu. Sao chép thành .env rồi chỉnh.
# KHÔNG đặt bí mật trong tệp này. Bí mật được sinh tự động trong data/ (0600).

COWORK_ENV=local
COWORK_HOST=127.0.0.1
COWORK_PORT=8899
COWORK_PUBLIC_URL=http://127.0.0.1:8899
COWORK_INTERNAL_URL=http://127.0.0.1:8899
COWORK_COOKIE_SECURE=0
# Chỉ bật khi chạy sau Caddy đã ghi đè X-Real-IP (production).
COWORK_TIN_PROXY=0
COWORK_SESSION_HOURS=12
COWORK_IDLE_MINUTES=60
COWORK_PASSWORD_MIN=10
COWORK_TENANT=vip-group

# VIP AI BRAIN — staging local trong lúc nghiệm thu
COWORK_BRAIN_ENABLED=1
COWORK_BRAIN_BASE_URL=http://127.0.0.1:18892
COWORK_BRAIN_PUBLIC_URL=http://127.0.0.1:18892
COWORK_BRAIN_TIMEOUT=3
COWORK_BRAIN_TICKET_TTL=60

# --- PRODUCTION (chỉ bật sau khi chủ dự án phê duyệt) ---
# COWORK_ENV=production
# COWORK_PUBLIC_URL=https://cowork.vipgroup.com.vn
# COWORK_INTERNAL_URL=http://127.0.0.1:8899
# COWORK_COOKIE_SECURE=1
# COWORK_TIN_PROXY=1
# COWORK_BRAIN_BASE_URL=http://127.0.0.1:8891
# COWORK_BRAIN_PUBLIC_URL=https://ai.vipgroup.com.vn

# --- REALM KHÁCH (cổng khách hàng P1) — mặc định TẮT. Dev: ./scripts/khach-dev.sh ---
# Bí mật VIPID_PORTAL_SECRET KHÔNG đặt ở đây: dùng env hoặc tệp 0600 (VIPID_PORTAL_SECRET_FILE).
# Production + bật realm sẽ TỪ CHỐI khởi động cho tới khi có kênh gửi email thật (A8).
# COWORK_KHACH_ENABLED=0
# Tên host khách phải khác tên host nhân viên (không chỉ khác cổng).
# COWORK_KHACH_HOSTS=khach.localhost:8898
# Danh sách trắng host nhân viên; khi realm khách bật, Host lạ ⇒ 421.
# BẮT BUỘC ở production khi bật realm khách (thiếu ⇒ từ chối khởi động; dev chỉ cảnh báo).
# COWORK_STAFF_HOSTS=127.0.0.1:8899
# COWORK_KHACH_PUBLIC_URL=http://khach.localhost:8898
# CRM_PORTAL_INTERNAL_URL=http://127.0.0.1:8897
# CRM_PORTAL_PUBLIC_URL=http://127.0.0.1:8897
# COWORK_KHACH_MAIL_TRANSPORT=outbox
# Cloudflare Turnstile cho thử thách đăng nhập (BẮT BUỘC ở production khi bật realm khách).
# Secret KHÔNG đặt ở đây: env COWORK_KHACH_TURNSTILE_SECRET hoặc tệp 0600
# COWORK_KHACH_TURNSTILE_SECRET_FILE (mặc định data/turnstile_secret.key).
# Dev/test có thể dùng khoá thử nghiệm Cloudflare: site 1x00000000000000000000AA.
# COWORK_KHACH_TURNSTILE_SITE_KEY=
# Owner 07/11: không xác minh email/SĐT; email tự phục vụ TẮT mặc định (khôi phục do nhân viên).
# COWORK_KHACH_EMAIL_ENABLED=0
# COWORK_KHACH_HOTLINE=0961 102 655
# COWORK_KHACH_SIGNUP_GLOBAL_PER_HOUR=200
# COWORK_KHACH_SYNC_GIAY=5
# Pilot (production BẮT BUỘC đặt 0 hoặc 1) + công tắc bảo trì (touch để đóng, rm để mở)
# COWORK_KHACH_PILOT=1
# COWORK_KHACH_PILOT_PHONES=
# COWORK_KHACH_PILOT_FILE=data/khach_pilot.txt
# COWORK_KHACH_MAINTENANCE_FILE=data/khach_bao_tri.flag
